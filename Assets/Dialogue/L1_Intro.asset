%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0aac39f57f6148d4c9eceb11c1561000, type: 3}
  m_Name: L1_Intro
  m_EditorClassIdentifier: 
  dialogueId: L1_Intro
  lines:
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "我族与巫乐为伍，逝者灵魂必将前往乐土往生。"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "凡事总有例外，困苦的灵魂徘徊迷路，在四日月圆时返回我族圣塔。圣地不堪重负，我等职责为弹奏巫乐，引渡族人灵魂返回正确道路。"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "听好，见习祭司，今日是你历练之日。若你能独掌大局完成仪式，你将正式成为我族渡灵祭司。"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: 616ffbba46844d5b8b1bd1c6430188d9, type: 2}
    text: "我很担心......我该怎么做？"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "选择空地，将巫乐塔置于灵魂洄游路径上，你可以随时拆除重建。记住，第一夜你只有铃鸣塔，这是必要的试炼。"
    portraitOverride: {fileID: 0}
    rewardSprite: {fileID: 21300000, guid: 5373f6fd9d9174141a55c088e21cc494, type: 3}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "准备好了吗？"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "很好。愿乐灵永随诸身。"
    portraitOverride: {fileID: 0}
