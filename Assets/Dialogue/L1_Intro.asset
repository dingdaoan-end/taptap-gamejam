  lines:
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "\u3010\u7B2C\u4E00\u5173\u5F00\u573A\u5360\u4F4D\u3011\u6B22\u8FCE\u6765\u5230\u8FD9\u91CC\u3002\u5148\u9009\u62E9\u4E00\u5757\u5408\u9002\u7684\u7A7A\u5730\uFF0C\u5EFA\u9020\u94C3\u94DB\u5854\u3002"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "\u51C6\u5907\u597D\u540E\u70B9\u51FB\u201C\u5F00\u59CB\u6218\u6597\u201D\u3002\u6218\u6597\u671F\u95F4\u4E5F\u53EF\u4EE5\u7EE7\u7EED\u5EFA\u9020\u548C\u62C6\u9664\u9632\u5FA1\u5854\u3002"
    portraitOverride: {fileID: 0}
