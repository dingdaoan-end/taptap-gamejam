  dialogueId: L4_Clear
  lines:
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "愿乐灵永随汝身！在众魂的见证下，我授予你渡灵祭司之名。"
    portraitOverride: {fileID: 0}
  - character: {fileID: 11400000, guid: acd9776329531dc47b1a1a163a22de74, type: 2}
    text: "汝与乐，圣坛与灵魂，乐土与肉身本为一物。我期待下个仪式你的乐声。（可建造乐塔总数+1）"
    portraitOverride: {fileID: 0}
